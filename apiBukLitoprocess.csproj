<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DotNetEnv" Version="3.1.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.21" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <!-- El proyecto usa el SDK Web, que incluye **/*.cs por convención.
       Excluimos la carpeta de pruebas para que no se compile dentro de la API. -->
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Content Remove="tests/**/*" />
    <None Remove="tests/**/*" />
  </ItemGroup>

  <!-- JSON de emulación de Buk embebido como recurso (lo lee BukEmulador). -->
  <ItemGroup>
    <None Remove="Services/colaborador_emulado.json" />
    <EmbeddedResource Include="Services/colaborador_emulado.json" />
  </ItemGroup>

  <!-- Permite que el proyecto de pruebas acceda a miembros internal (GetColaboradorByIdBuk). -->
  <ItemGroup>
    <InternalsVisibleTo Include="apiBukLitoprocess.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="clases/" />
    <Folder Include="conf/" />
    <Folder Include="helpers/" />
    <Folder Include="payloads/" />
    <Folder Include="repository/implementation/" />
    <Folder Include="repository/interfaces/" />
    <Folder Include="responseApi/" />
  </ItemGroup>

</Project>
